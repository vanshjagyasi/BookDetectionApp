# ============================================================
# OpenAI — Required
# Get your key at: https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=sk-your-key-here

# Model for vision extraction (Stage 1). Must support vision input.
OPENAI_MODEL=gpt-4o

# Model for synthesis (Stage 3). gpt-4o-mini is faster/cheaper for text-only tasks.
OPENAI_SYNTHESIS_MODEL=gpt-4o-mini

# Vision detail level: "high", "low", or "auto".
# "auto" lets the API choose — good balance of speed and accuracy.
# "high" forces full-resolution tiling (slower but better for tiny text/ISBNs).
VISION_DETAIL=auto

# ============================================================
# Google Books API — Required only for scripts/populate_db.py
# Get your key at: https://console.cloud.google.com/
# Enable "Books API" in the Cloud Console.
# ============================================================
GOOGLE_BOOKS_API_KEY=AIzaSy-your-key-here

# ============================================================
# ChromaDB — Vector Store Configuration
# ============================================================
# Directory where ChromaDB stores its persistent data on disk.
# Must be writable. Created automatically if it doesn't exist.
CHROMA_PERSIST_DIR=./data/chroma_db

# Name of the ChromaDB collection holding book documents.
CHROMA_COLLECTION_NAME=books

# ============================================================
# Embedding & Re-ranking Models (sentence-transformers)
# ============================================================
# Bi-encoder: converts book text into vectors for ChromaDB similarity search.
# Downloaded from HuggingFace on first run (~80MB).
# WARNING: changing this after seeding the DB requires re-running populate_db.py.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# How many candidates to fetch from ChromaDB before cross-encoder re-ranking.
RAG_FETCH_K=10

# Cross-encoder re-ranker: precisely scores the RAG_FETCH_K candidates.
# Downloaded from HuggingFace on first run (~80MB).
# Set to empty string ("") to disable re-ranking.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Final number of re-ranked candidates passed to GPT-4o for synthesis.
RERANK_TOP_K=3

# ============================================================
# Langfuse LLM Observability (optional)
# Sign up free at: https://cloud.langfuse.com
# Traces are disabled if keys are left empty.
# ============================================================
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_HOST=http://localhost:3000

# ============================================================
# API Settings
# ============================================================
# Maximum allowed image upload size in megabytes.
MAX_IMAGE_SIZE_MB=20

# Comma-separated list of CORS origins. Use ["*"] to allow all.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
